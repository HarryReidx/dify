# Enhanced Document Processing Plugin Configuration

# Format Conversion Settings
EDP_ENABLE_FORMAT_CONVERSION=true
EDP_CONVERSION_ENGINE=auto
EDP_LIBREOFFICE_PATH=/usr/bin/libreoffice
EDP_PANDOC_PATH=/usr/bin/pandoc
EDP_CONVERSION_TIMEOUT=300

# Image Processing Settings
EDP_ENABLE_IMAGE_PROCESSING=true
EDP_IMAGE_QUALITY=85
EDP_MAX_IMAGE_SIZE=5242880

# MinIO Configuration (required if image processing is enabled)
EDP_MINIO_ENDPOINT=localhost:9000
EDP_MINIO_ACCESS_KEY=minioadmin
EDP_MINIO_SECRET_KEY=minioadmin
EDP_MINIO_BUCKET=dify-images
EDP_MINIO_SECURE=false
EDP_MINIO_REGION=us-east-1

# Document Segmentation Settings
EDP_MAX_SEGMENT_LENGTH=1000
EDP_MIN_SEGMENT_LENGTH=100
EDP_OVERLAP_LENGTH=50
EDP_ENABLE_PARENT_CHILD_SEGMENTATION=true

# Upload Settings
EDP_UPLOAD_METHOD=auto
EDP_HTTP_API_SIZE_LIMIT=1048576
EDP_ENABLE_UPLOAD_RETRY=true
EDP_MAX_RETRY_ATTEMPTS=3
EDP_RETRY_DELAY=1.0

# MinerU Integration
EDP_MINERU_CONFIG_PATH=
EDP_ENABLE_MINERU_ENHANCEMENT=true

# Exam Generation Settings
EDP_ENABLE_EXAM_GENERATION=true
EDP_DEFAULT_QUESTION_COUNT=10
