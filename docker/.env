VECTOR_STORE=qdrant

# Qdrant 配置
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# 本地 Docker 版一般不需要 API Key，留空即可
QDRANT_API_KEY=


# 数据库配置
DB_USERNAME=postgres
DB_PASSWORD=TyAdmin@2026
DB_HOST=db_postgres
DB_PORT=5432
DB_DATABASE=dify

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=TyAdmin@2026

# 基础配置
SECRET_KEY=sk-9f73s3ljTXVcMT3Blb3ljTqtsKiGHXVcMT3BlbkFJLK7U
DEBUG=true
MIGRATION_ENABLED=true

# 文件访问配置 - 重要：需要设置为外部可访问的地址
FILES_URL=http://api:5001
CONSOLE_API_URL=
SERVICE_API_URL=
APP_API_URL=

# 日志配置
LOG_LEVEL=DEBUG

# 平台使用使用minio存储
STORAGE_TYPE=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET_NAME=ty-ai-flow
S3_ACCESS_KEY=minioadmin              # 用你的实际账号
S3_SECRET_KEY=TyAdmin@2026            # 用你的实际密码
S3_REGION=us-east-1                   # MinIO 随便填一个常见区域名即可

# minio初始化用户密码
MINIO_ACCESS_KEY:minioadmin
MINIO_SECRET_KEY:TyAdmin@2026
# Milvus 启动时会读取这些来连接 MinIO
MINIO_ADDRESS=minio:9000

# 上传文件大小限制
UPLOAD_FILE_SIZE_LIMIT=200
UPLOAD_IMAGE_FILE_SIZE_LIMIT=10

