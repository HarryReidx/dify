# 【硬件模式】指定 RAGFlow 使用 GPU 还是 CPU 运行 DeepDoc 视觉解析任务
DEVICE=gpu
# ================================
# 第一部分 DIFY 专属配置
# ================================

# web端口
EXPOSE_NGINX_PORT=80
EXPOSE_NGINX_SSL_PORT=4443

# 插件签名验证
FORCE_VERIFYING_SIGNATURE=false

# 镜像源
PIP_MIRROR_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# 向量数据库配置
# VECTOR_STORE=weaviate
# WEAVIATE_ENDPOINT=http://weaviate:8080
# WEAVIATE_API_KEY=WVF5YThaHlkYwhGUSmCRgsX3tD5ngdN8pkih
CERTBOT_EMAIL=
CERTBOT_DOMAIN=
# VECTOR_STORE=milvus

# # Milvus 连接配置
# MILVUS_HOST=milvus-standalone
# MILVUS_PORT=19530
# MILVUS_USER=root
# MILVUS_PASSWORD=Milvus
VECTOR_STORE=qdrant

# Qdrant 配置
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# 本地 Docker 版一般不需要 API Key，留空即可
QDRANT_API_KEY=



# pg数据库配置
# DB_USERNAME=postgres
# DB_PASSWORD=TyAdmin@2026
# DB_HOST=db_postgres
# DB_PORT=5432
# DB_DATABASE=dify

DB_TYPE=mysql
# mysql数据库配置,Mysql目前支持root用户
DB_USERNAME=root
DB_PASSWORD=TyAdmin@2026
DB_HOST=db_mysql
DB_PORT=3306
DB_DATABASE=dify

# Redis 配置
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=TyAdmin@2026

# 基础配置
SECRET_KEY=sk-9f73s3ljTXVcMT3Blb3ljTqtsKiGHXVcMT3BlbkFJLK7U
DEBUG=true
MIGRATION_ENABLED=true

# 文件访问配置 - 重要：需要设置为外部可访问的地址
FILES_URL=http://117.50.195.138:5001
# 控制台 API 的地址
CONSOLE_API_URL=http://117.50.195.138
# 控制台前端地址
CONSOLE_WEB_URL=http://117.50.195.138
# 供前端调用的 API 地址
SERVICE_API_URL=
# 针对 WebApp 的 API 地址
APP_API_URL=
# 链接签名过期时间
FILES_ACCESS_TIMEOUT=315360000

# 日志配置
LOG_LEVEL=DEBUG

# 平台使用使用minio存储
STORAGE_TYPE=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET_NAME=ty-ai-flow
# 用你的实际账号
S3_ACCESS_KEY=minioadmin
# 用你的实际密码
S3_SECRET_KEY=TyAdmin@2026
# MinIO 随便填一个常见区域名即可
S3_REGION=us-east-1

# minio初始化用户密码
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=TyAdmin@2026
# Milvus 启动时会读取这些来连接 MinIO
MINIO_ADDRESS=minio:9000

# 上传文件大小限制
UPLOAD_FILE_SIZE_LIMIT=200
UPLOAD_IMAGE_FILE_SIZE_LIMIT=10

# 修改 RAGFlow 的 ES 指向
# 对应 Dify 的 container_name
ES_HOST=elasticsearch
# 对应容器内端口
ES_PORT=9200
 # 必须与 Dify 的 ELASTICSEARCH_PASSWORD 一致
ELASTIC_PASSWORD=TyAdmin@2026


# ================================================
# 第二部分 RAGFlow 专属配置 (修正变量名以对齐镜像脚本)
# ================================================
# RAGFLOW_IMAGE=infiniflow/ragflow:v0.22.1
RAGFLOW_IMAGE=swr.cn-north-4.myhuaweicloud.com/infiniflow/ragflow:v0.22.1
# 文件解析大小最大为 1GB (1024 * 1024 * 1024)
MAX_CONTENT_LENGTH=1073741824

REGISTER_ENABLED=1  # 设为 1 表示允许注册

# 搜索引擎配置 (对接 Dify 的 Elasticsearch)
DOC_ENGINE=elasticsearch
ES_HOST=elasticsearch
ES_PORT=9200
ELASTIC_PASSWORD=TyAdmin@2026 # 确保与 Dify ES 启动密码一致

# RAGFlow 端口
SVR_WEB_HTTP_PORT=8082
SVR_WEB_HTTPS_PORT=444
SVR_HTTP_PORT=9380
ADMIN_SVR_HTTP_PORT=9381
SVR_MCP_PORT=9382

# 数据库对齐 (注意：变量名必须是 MYSQL_ 开头)
MYSQL_HOST=db_mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=TyAdmin@2026
MYSQL_DBNAME=rag_flow

# Redis 对齐
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=TyAdmin@2026

# MinIO 对齐
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_USER=minioadmin
MINIO_PASSWORD=TyAdmin@2026
# RAGFlow 必须指定一个 Bucket 名字（建议先在 MinIO 控制台创建此 Bucket）
MINIO_BUCKET=ty-ai-flow
MINIO_PREFIX_PATH=ragflow
BUCKET=ty-ai-flow

# MinerU 配置
# # 1. 开启总开关
# USE_MINERU=true
# # 2. 这里的可执行路径可以保留默认，或者指向容器内的 python3
# # 因为我们后续会走 API 模式，这个路径不会被真正执行，但 USE_MINERU 必须为 true 才会激活 UI 上的相关选项
# MINERU_EXECUTABLE="/usr/bin/python3"
# # 3. 建议保留输出结果，方便在本地 volumes/mineru-output 中排查解析质量
# MINERU_DELETE_OUTPUT=0
# # 4. 后端选择 pipeline（对应你 mineru-api 的处理逻辑）
# MINERU_BACKEND=pipeline

# RAGFlow 其他必要参数
TZ=Asia/Shanghai
STACK_VERSION=8.14.3
MEM_LIMIT=8073741824

# pptx support
DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
